# Optional AWS integration. Keep these values on the backend only.
# Never put AWS credentials or this configuration in Vite/browser environment variables.
CLOUDGUARD_AWS_ROLE_ARN=
CLOUDGUARD_AWS_EXTERNAL_ID=
CLOUDGUARD_AWS_REGION=ap-south-1
CLOUDGUARD_DB_PATH=./data/cloudguard.db
CLOUDGUARD_CORS_ORIGINS=http://localhost:5173
